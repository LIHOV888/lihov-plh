# =============================================================================
# LIHOV PLH Website — Environment Variables Example
# Copy this file to .env.local for local development or configure in Vercel.
# NEVER commit .env.local or real secrets to GitHub.
# =============================================================================

# Canonical primary domain URL (include https://, no trailing slash)
# Example: https://lihov.com
NEXT_PUBLIC_SITE_URL=https://lihov.com

# Optional: Google Search Console HTML meta tag verification code
# Provide ONLY the token value from the content="..." attribute.
# Leave blank if using DNS TXT or HTML file verification instead.
GOOGLE_SITE_VERIFICATION=

# Optional: Server-side webhook URL for contact & data-deletion form delivery
# (e.g., an authenticated Formspree/Make/Zapier/custom intake HTTPS endpoint).
# If left blank, public forms honestly report that automated delivery is not
# yet connected and provide direct official email instructions instead.
CONTACT_WEBHOOK_URL=

# Optional: Bearer token sent as Authorization header to CONTACT_WEBHOOK_URL
CONTACT_WEBHOOK_SECRET=
